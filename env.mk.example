# Copy to env.mk (git-ignored) and uncomment what you need.
# JAVA_HOME    = /usr/lib/jvm/java-17-openjdk
# ANDROID_HOME = $(HOME)/Android/Sdk
# ADB          = $(ANDROID_HOME)/platform-tools/adb

# Release signing (used by `make release`; keep this file git-ignored).
# export KEYSTORE          = $(HOME)/my-release.jks
# export KEYSTORE_PASSWORD = changeme
# export KEY_PASSWORD      = changeme
# export KEY_ALIAS         = release
# Fail `make release`/`make publish` if the APK is signed with any other key:
# export RELEASE_CERT_SHA256 = <sha256 of the release certificate, from `keytool -list -v`>
